@startuml
title EvSafeService Sequence Diagram

participant EVSafe_app
participant EvSafeService_API
actor System
participant BootCompleteReceiver
participant Context
participant EvSafeService
participant EvSafeServiceNotificationHelper
participant CarPropertyManager
participant EvSafeServiceData
participant EvSafeServiceDataManager

System -> BootCompleteReceiver: BOOT_COMPLETED
BootCompleteReceiver -> BootCompleteReceiver: onReceive()
BootCompleteReceiver -> Context: startService(Intent)
Context -> EvSafeService: onCreate()
EvSafeServiceNotificationHelper -> EvSafeService : new EvSafeServiceNotificationHelper()
CarPropertyManager -> EvSafeService: new CarPropertyManager()
EvSafeServiceData -> EvSafeService: new EvSafeServiceData()

EvSafeService -> EvSafeServiceDataManager: new EvSafeServiceDataManager(CarPropertyManager, EvSafeServiceData, EvSafeServiceDataUpdateListener)
EvSafeService -> EvSafeServiceDataManager: registerListeners()

Context -> EvSafeService: onStartCommand()
note over EvSafeService: Start service operations

EvSafeServiceDataManager -> CarPropertyManager: registerCallback(propertyEventCallback)

loop Main Event
    CarPropertyManager -> EvSafeServiceDataManager: onChangeEvent(CarPropertyValue)
    activate EvSafeServiceDataManager
    EvSafeServiceDataManager -> EvSafeServiceDataManager: handlePropertyChange()
    note over EvSafeServiceDataManager: if propoerty is changed
    EvSafeServiceDataManager -> EvSafeServiceData: EvSafeServiceData.setValue()
    EvSafeServiceDataManager -> EvSafeServiceNotificationHelper: showWarningNotification()
    EvSafeServiceDataManager -> EvSafeService: EvSafeServiceDataUpdateListener.onEvSafeServiceDataUpdated()
    deactivate EvSafeServiceDataManager
    activate EVSafe_app
    EvSafeService -> EVSafe_app: EvSafeServiceDataUpdateListener.onEvSafeServiceDataUpdated()
    EVSafe_app -> EVSafe_app: updateUI()
    deactivate EVSafe_app
end
@enduml
